---
const nav = [
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
]
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 bg-paper text-ocean">
  <nav class="relative mx-auto flex h-[52px] max-w-6xl items-center justify-end px-4 sm:px-6 md:h-[72px] lg:px-8">
    <a
      href="/"
      class="header-title pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-display text-xl uppercase tracking-wide text-ocean md:text-4xl leading-none whitespace-nowrap"
    >
      Bluewave Visuals
    </a>

    <button
      id="menu-toggle"
      class="relative z-50 flex h-5 w-6 flex-col justify-between focus:outline-none"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar block h-0.5 w-6 origin-center transition-all duration-300"></span>
      <span class="bar block h-0.5 w-6 origin-center transition-all duration-300"></span>
      <span class="bar block h-0.5 w-6 origin-center transition-all duration-300"></span>
    </button>

    <div
      id="mobile-menu"
      class="pointer-events-none fixed inset-0 z-40 flex h-screen flex-col items-center justify-center gap-10 bg-paper text-2xl uppercase text-ocean opacity-0 transition-opacity duration-300"
    >
      {
        nav.map(item => (
          <a href={item.href} class="transition-opacity hover:opacity-60">
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("menu-toggle")
    const menu = document.getElementById("mobile-menu")
    if (!btn || !menu) return

    const openMenu = () => {
      btn.classList.add("open")
      btn.setAttribute("aria-expanded", "true")
      menu.classList.remove("opacity-0", "pointer-events-none")
      menu.classList.add("opacity-100", "pointer-events-auto")
      document.documentElement.classList.add("overflow-hidden")
    }

    const closeMenu = () => {
      btn.classList.remove("open")
      btn.setAttribute("aria-expanded", "false")
      menu.classList.remove("opacity-100", "pointer-events-auto")
      menu.classList.add("opacity-0", "pointer-events-none")
      document.documentElement.classList.remove("overflow-hidden")
    }

    btn.addEventListener("click", () => {
      const isOpen = btn.classList.contains("open")
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    })

    menu.addEventListener("click", e => {
      const el = e.target
      if (el instanceof HTMLElement && el.tagName === "A") {
        closeMenu()
      }
    })
  })
</script>

<style>
  #site-header .bar {
    background-color: rgb(var(--ocean));
  }

  #menu-toggle.open .bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  #menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }

  #menu-toggle.open .bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  .bar {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
</style>
