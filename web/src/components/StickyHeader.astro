---
const nav = [
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
]
---

<header
  id="site-header"
  data-state="shown"
  class="fixed inset-x-0 top-0 z-50 transition-transform duration-300 ease-out"
>
  <nav class="relative mx-auto flex h-[52px] max-w-6xl items-center justify-between px-4 sm:px-6 md:h-[72px] lg:px-8">
    <a
      href="/"
      class="font-display text-xl uppercase tracking-wide leading-none whitespace-nowrap md:text-3xl"
    >
      Bluewave Visuals
    </a>

    <ul class="hidden md:flex items-center gap-8 font-display uppercase tracking-wide text-base">
      {
        nav.map(item => (
          <li>
            <a href={item.href} class="transition-opacity hover:opacity-70">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="menu-toggle"
      class="relative z-50 flex h-5 w-6 flex-col justify-between focus:outline-none md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar block h-0.5 w-6 origin-center transition-all duration-300"></span>
      <span class="bar block h-0.5 w-6 origin-center transition-all duration-300"></span>
      <span class="bar block h-0.5 w-6 origin-center transition-all duration-300"></span>
    </button>

    <div
      id="mobile-menu"
      class="pointer-events-none fixed inset-0 z-40 flex h-screen flex-col items-center justify-center gap-10 bg-paper text-2xl uppercase text-ocean opacity-0 transition-opacity duration-300 md:hidden"
    >
      {
        nav.map(item => (
          <a href={item.href} class="transition-opacity hover:opacity-60">
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("site-header")
    if (!header) return

    let last = window.scrollY

    const setState = (state: "shown" | "hidden") => {
      if (header.dataset.state !== state) header.dataset.state = state
    }

    const update = () => {
      const y = window.scrollY

      if (y <= 0) {
        setState("shown")
      } else if (y > last + 2) {
        setState("hidden")
      } else if (y < last - 2) {
        setState("shown")
      }

      last = y
    }

    update()

    let ticking = false
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          update()
          ticking = false
        })
      },
      { passive: true },
    )

    const btn = document.getElementById("menu-toggle")
    const menu = document.getElementById("mobile-menu")
    if (!btn || !menu) return

    const openMenu = () => {
      btn.classList.add("open")
      btn.setAttribute("aria-expanded", "true")
      menu.classList.remove("opacity-0", "pointer-events-none")
      menu.classList.add("opacity-100", "pointer-events-auto")
      document.documentElement.classList.add("overflow-hidden")
    }

    const closeMenu = () => {
      btn.classList.remove("open")
      btn.setAttribute("aria-expanded", "false")
      menu.classList.remove("opacity-100", "pointer-events-auto")
      menu.classList.add("opacity-0", "pointer-events-none")
      document.documentElement.classList.remove("overflow-hidden")
    }

    btn.addEventListener("click", () => {
      if (btn.classList.contains("open")) closeMenu()
      else openMenu()
    })

    menu.addEventListener("click", e => {
      const el = e.target
      if (el instanceof HTMLElement && el.tagName === "A") {
        closeMenu()
      }
    })
  })
</script>

<style>
  #site-header {
    color: rgb(var(--paper));
  }
  #site-header[data-state="shown"] {
    transform: translateY(0);
  }
  #site-header[data-state="hidden"] {
    transform: translateY(-100%);
  }

  #site-header .bar {
    background-color: rgb(var(--paper));
  }

  #menu-toggle.open .bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  #menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }

  #menu-toggle.open .bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  .bar {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
</style>
