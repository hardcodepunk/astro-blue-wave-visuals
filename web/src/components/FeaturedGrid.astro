---
import { sanity, urlFor } from "../lib/sanity"

type Project = {
  title: string
  slug: { current: string }
  thumbnail: any
}

const projects: Project[] = await sanity.fetch(`
  *[_type == "project" && featured == true]
  | order(order asc) {
    title,
    slug,
    thumbnail
  }
`)
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="flex items-end justify-between">
    <h2 class="font-display text-3xl">Featured Work</h2>
    <a href="/portfolio" class="text-sm underline underline-offset-4"> View all </a>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map(p => (
        <a href={`/portfolio/${p.slug.current}`} class="group block">
          <div class="overflow-hidden rounded-xl">
            <img
              src={urlFor(p.thumbnail).width(1600).height(1200).fit("crop").url()}
              alt={p.title}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <div class="mt-3">
            <h3 class="text-lg font-semibold">{p.title}</h3>
          </div>
        </a>
      ))
    }
  </div>
</section>
