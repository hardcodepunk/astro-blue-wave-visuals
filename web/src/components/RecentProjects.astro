---
import { sanity, urlFor } from "../lib/sanity"

type Project = {
  _id: string
  title: string
  slug?: { current: string }
  thumbnail?: { asset?: { _ref: string } }
}

const projects: Project[] = await sanity.fetch(`
  *[_type == "project" && defined(thumbnail.asset)]
  | order(featured desc, order asc, _createdAt desc) [0...3] {
    _id,
    title,
    slug,
    thumbnail
  }
`)

const featured = projects[0]
const secondary = projects.slice(1, 3)
---

{
  featured && (
    <section class="bg-paper py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-4">
        <div class="flex flex-col gap-3 text-center sm:flex-row sm:items-end sm:justify-between sm:text-left">
          <div>
            <p class="text-xs uppercase tracking-[0.25em] text-ocean/70 sm:text-sm">
              Recent work
            </p>
            <h2 class="mt-2 font-display text-5xl uppercase leading-[0.95] tracking-wide text-ocean sm:text-6xl md:text-7xl">
              Selected projects
            </h2>
          </div>
        </div>

        <div class="mt-10 md:mt-14">
          <a
            href={featured.slug ? `/projects/${featured.slug.current}` : "/projects"}
            class="group block overflow-hidden"
          >
            <div class="overflow-hidden">
              <img
                src={urlFor(featured.thumbnail).width(2400).height(1350).fit("crop").url()}
                alt={featured.title}
                loading="lazy"
                decoding="async"
                class="block aspect-video w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              />
            </div>
            <div class="mt-4 flex items-baseline justify-between gap-4">
              <h3 class="font-display text-2xl uppercase leading-tight tracking-wide text-ocean sm:text-3xl">
                {featured.title}
              </h3>
              <span class="font-display text-xs uppercase tracking-[0.2em] text-ocean/60 sm:text-sm">
                View
              </span>
            </div>
          </a>
        </div>

        {secondary.length > 0 && (
          <div class="mt-10 grid gap-6 sm:grid-cols-2 md:mt-12 md:gap-8">
            {secondary.map(p => (
              <a
                href={p.slug ? `/projects/${p.slug.current}` : "/projects"}
                class="group block overflow-hidden"
              >
                <div class="overflow-hidden">
                  <img
                    src={urlFor(p.thumbnail).width(1600).height(900).fit("crop").url()}
                    alt={p.title}
                    loading="lazy"
                    decoding="async"
                    class="block aspect-video w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                  />
                </div>
                <div class="mt-3 flex items-baseline justify-between gap-4">
                  <h3 class="font-display text-xl uppercase leading-tight tracking-wide text-ocean sm:text-2xl">
                    {p.title}
                  </h3>
                  <span class="font-display text-xs uppercase tracking-[0.2em] text-ocean/60">
                    View
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class="mt-12 flex justify-center md:mt-16">
          <a
            href="/projects"
            class="inline-flex items-center justify-center rounded-full border border-ocean px-8 py-3 font-display text-base uppercase tracking-wide text-ocean transition hover:bg-ocean hover:text-paper sm:text-lg"
          >
            All projects
          </a>
        </div>
      </div>
    </section>
  )
}
