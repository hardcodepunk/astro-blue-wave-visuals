---
import { sanity } from "../lib/sanity"

type Settings = {
  contactEmail?: string
  instagramUrl?: string
  shopUrl?: string
} | null

type Service = {
  _id: string
  title: string
  href?: string
}

const [settings, services] = await Promise.all([
  sanity.fetch<Settings>(`
    *[_type == "siteSettings" && _id == "siteSettings"][0]{
      contactEmail,
      instagramUrl,
      shopUrl
    }
  `),
  sanity.fetch<Service[]>(`
    *[_type == "service"] | order(order asc, _createdAt asc){
      _id,
      title,
      href
    }
  `),
])

const email = settings?.contactEmail ?? "info@bluewavevisuals.com"
const instagram = settings?.instagramUrl ?? "https://www.instagram.com/bluewave.visuals/"
const shop = settings?.shopUrl
const year = new Date().getFullYear()

const studioLinks = [
  { label: "About", href: "#bio" },
  { label: "Process", href: "#process" },
  { label: "Trusted by", href: "#trusted" },
  { label: "Contact", href: "#contact" },
]
---

<footer class="border-t border-ocean/15 bg-paper text-ocean">
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 md:pt-20">
    <div class="grid gap-14 md:grid-cols-3 md:gap-12 lg:grid-cols-5">

      <div class="lg:col-span-2">
        <p class="text-xs uppercase tracking-[0.25em] text-ocean/70">
          Subscribe to our newsletter
        </p>

        <form
          id="footer-subscribe"
          class="mt-4 flex w-full max-w-md flex-col gap-2 sm:flex-row"
          action="#"
          novalidate
        >
          <label class="sr-only" for="footer-email">Email address</label>
          <input
            id="footer-email"
            name="email"
            type="email"
            required
            placeholder="Email"
            class="w-full bg-transparent border-b border-ocean/40 py-2 text-base text-ocean placeholder:text-ocean/50 focus:border-ocean focus:outline-none"
          />
          <button
            type="submit"
            class="bg-ocean px-6 py-2 font-display text-base uppercase tracking-wide text-paper transition hover:bg-ocean/85"
          >
            Submit
          </button>
        </form>

        <p id="footer-subscribe-msg" class="mt-3 hidden text-xs text-ocean/70"></p>

        <div class="mt-10">
          <p class="text-xs uppercase tracking-[0.25em] text-ocean/70">
            Contact us
          </p>
          <a href={`mailto:${email}`} class="mt-3 inline-block text-base underline underline-offset-4 transition hover:opacity-70 sm:text-lg">
            {email}
          </a>
        </div>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-ocean/70">Work</p>
        <ul class="mt-4 space-y-2 text-base">
          {
            services.map(s => (
              <li>
                <a href={s.href || "#"} class="transition hover:opacity-70">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-ocean/70">Studio</p>
        <ul class="mt-4 space-y-2 text-base">
          {
            studioLinks.map(link => (
              <li>
                <a href={link.href} class="transition hover:opacity-70">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-ocean/70">Follow</p>
        <ul class="mt-4 space-y-2 text-base">
          <li>
            <a href={instagram} target="_blank" rel="noopener noreferrer" class="transition hover:opacity-70">
              Instagram
            </a>
          </li>
          {
            shop && (
              <li>
                <a href={shop} target="_blank" rel="noopener noreferrer" class="transition hover:opacity-70">
                  Shop
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center gap-2 border-t border-ocean/15 pt-6 text-xs text-ocean/70 sm:flex-row sm:justify-between">
      <p class="font-display uppercase tracking-wide">© {year} Bluewave Visuals</p>
      <p>
        <a href="#" class="transition hover:text-ocean">Privacy</a>
        <span class="px-2">/</span>
        <a href="#" class="transition hover:text-ocean">Terms</a>
      </p>
    </div>
  </div>
</footer>

<script>
  ;(() => {
    const form = document.getElementById("footer-subscribe") as HTMLFormElement | null
    const msg = document.getElementById("footer-subscribe-msg")
    if (!form || !msg) return

    form.addEventListener("submit", e => {
      e.preventDefault()
      const data = new FormData(form)
      const email = String(data.get("email") || "").trim()
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = "Please enter a valid email address."
        msg.classList.remove("hidden")
        return
      }
      // TODO: wire up to Mailchimp / Buttondown / etc.
      msg.textContent = "Thanks — we'll be in touch."
      msg.classList.remove("hidden")
      form.reset()
    })
  })()
</script>
