---
import { sanity, urlFor } from "../lib/sanity"

type Logo = {
  _key?: string
  name: string
  image?: { asset?: { _ref: string } }
  url?: string
}

type Doc = {
  eyebrow?: string
  logos?: Logo[]
} | null

const doc = await sanity.fetch<Doc>(`
  *[_type == "trustedBy" && _id == "trustedBy"][0]{
    eyebrow,
    logos
  }
`)

const eyebrow = doc?.eyebrow ?? "Trusted by"
const logos = (doc?.logos ?? []).filter(Boolean)
---

{
  logos.length > 0 && (
    <section id="trusted" class="bg-paper py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-4">
        <p class="text-center text-xs uppercase tracking-[0.25em] text-ocean/70 sm:text-sm">
          {eyebrow}
        </p>

        <div class="mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-3 md:mt-10 md:grid-cols-6">
          {logos.map(logo => {
            const inner = logo.image?.asset ? (
              <img
                src={urlFor(logo.image).width(320).height(120).fit("max").url()}
                alt={logo.name}
                loading="lazy"
                decoding="async"
                class="h-10 w-auto opacity-70 transition hover:opacity-100 md:h-12"
              />
            ) : (
              <span class="font-display text-base uppercase tracking-wide text-ocean/70 transition hover:text-ocean sm:text-lg">
                {logo.name}
              </span>
            )

            return (
              <div class="flex items-center justify-center">
                {logo.url ? (
                  <a href={logo.url} target="_blank" rel="noopener noreferrer" aria-label={logo.name}>
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </div>
            )
          })}
        </div>
      </div>
    </section>
  )
}
