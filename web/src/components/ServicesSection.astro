---
import { sanity, urlFor } from "../lib/sanity"

type Service = {
  title: string
  subtitle?: string
  href: string
  image: any
}

const services: Service[] = await sanity.fetch(`*[_type == "service"]|order(order asc){
  title,
  subtitle,
  href,
  image
}`)
---

<section class="w-full py-16 sm:py-20">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-2xl uppercase tracking-[0.08em] text-black sm:text-3xl">Services</h2>
      <p class="mt-3 text-sm leading-relaxed text-black/65 sm:text-base">
        Cinematic brand visuals shaped through motion, texture, light, and editorial composition.
      </p>
    </div>
  </div>

  <div class="mt-10 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {
        services.slice(0, 4).map(s => (
          <a href={s.href} class="group relative block h-[64vh] min-h-[420px] overflow-hidden">
            <img
              src={urlFor(s.image).width(1400).height(1800).fit("crop").url()}
              alt={s.title}
              class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />

            <div class="absolute inset-0 bg-black/10 transition duration-300 group-hover:bg-black/20" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent" />

            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
              <div class="text-center">
                <span class="inline-flex min-h-[44px] items-center border border-white/70 px-5 text-[12px] font-medium uppercase tracking-[0.18em] text-white transition duration-300 group-hover:bg-white group-hover:text-black">
                  {s.title}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
