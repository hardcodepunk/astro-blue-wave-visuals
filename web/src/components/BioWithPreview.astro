---
import { sanity, urlFor } from "../lib/sanity"

const DEFAULT_BIO = `We shoot clean, cinematic video for brands and people who care about craft.
Fast turnaround, calm sets, sharp edits. Commercials, social cuts, event recaps,
and story-driven pieces — done properly.`

const DEFAULT_IMAGE = "/img/horizontal-1.jpg"
const DEFAULT_ALT = "Bluewave Visuals on location"

type BioDoc = {
  bio?: string
  mirrorLayout?: boolean
  bioTextScale?: number
  previewImage?: {
    asset?: { _ref: string }
    alt?: string
  }
} | null

const doc = await sanity.fetch<BioDoc>(`
  *[_type == "bioWithPreview" && _id == "bioWithPreview"][0]{
    bio,
    mirrorLayout,
    bioTextScale,
    previewImage
  }
`)

const bio = doc?.bio ?? DEFAULT_BIO
const mirrorLayout = doc?.mirrorLayout ?? false
const textScale = Math.min(1.4, Math.max(0.75, (doc?.bioTextScale ?? 100) / 100))

const imageUrl = doc?.previewImage?.asset
  ? urlFor(doc.previewImage).width(1600).height(900).fit("crop").url()
  : DEFAULT_IMAGE
const imageAlt = doc?.previewImage?.alt ?? DEFAULT_ALT
---

<section class="bg-paper text-ocean py-16 md:py-20">
  <div
    class:list={[
      "mx-auto max-w-6xl px-4 grid gap-10 md:gap-12 items-center",
      "md:grid-cols-[1.15fr_0.85fr]",
      mirrorLayout && "md:[&>div:first-child]:order-2",
    ]}
    style={`--bio-scale: ${textScale};`}
  >
    <div>
      <p class="bp-bio whitespace-pre-line text-ocean">{bio}</p>
    </div>

    <div>
      <div class="overflow-hidden">
        <img
          src={imageUrl}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="block aspect-video h-auto w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .bp-bio {
    margin: 0;
    font-family: "Andada Pro", serif;
    font-size: clamp(calc(1rem * var(--bio-scale)), calc(1.4vw * var(--bio-scale)), calc(1.25rem * var(--bio-scale)));
    line-height: 1.5;
    letter-spacing: 0;
    max-width: 48ch;
  }
</style>
