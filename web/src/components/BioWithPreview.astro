---
import { sanity } from "../lib/sanity"

const DEFAULT_BIO = `Clean, cinematic video for people who care about craft.
Brands, sport, and stories worth telling.`

type BioDoc = {
  bio?: string
  bioTextScale?: number
} | null

const doc = await sanity.fetch<BioDoc>(`
  *[_type == "bioWithPreview" && _id == "bioWithPreview"][0]{
    bio,
    bioTextScale
  }
`)

const bio = doc?.bio ?? DEFAULT_BIO
const textScale = Math.min(1.4, Math.max(0.75, (doc?.bioTextScale ?? 100) / 100))
---

<section id="bio" class="bg-paper py-24 text-ocean md:py-32">
  <div class="mx-auto max-w-3xl px-4 text-center" style={`--bio-scale: ${textScale};`}>
    <p class="bp-bio whitespace-pre-line">{bio}</p>
  </div>
</section>

<style>
  .bp-bio {
    margin: 0;
    font-family: "Andada Pro", serif;
    font-size: clamp(calc(1.25rem * var(--bio-scale)), calc(2vw * var(--bio-scale)), calc(1.75rem * var(--bio-scale)));
    line-height: 1.45;
    letter-spacing: 0;
  }
</style>
