---
import "plyr/dist/plyr.css"
import { sanity } from "../lib/sanity"

type Settings = {
  showreelUrl?: string
  showreelPoster?: string
} | null

const settings = await sanity.fetch<Settings>(`
  *[_type == "siteSettings" && _id == "siteSettings"][0]{
    showreelUrl,
    showreelPoster
  }
`)

const DEFAULT_URL = "https://www.youtube.com/watch?v=cIFqyLFVG4g"
const DEFAULT_POSTER =
  "https://res.cloudinary.com/hardcodepunk/video/upload/q_auto:eco,so_0,f_jpg,w_1600/v1737957147/wsuszohtmu2pks673muc.jpg"

function getYouTubeId(input?: string | null): string | null {
  if (!input) return null
  const s = String(input).trim()
  if (!s) return null
  const patterns = [
    /(?:youtube\.com\/watch\?v=)([A-Za-z0-9_-]{6,})/,
    /(?:youtu\.be\/)([A-Za-z0-9_-]{6,})/,
    /(?:youtube\.com\/embed\/)([A-Za-z0-9_-]{6,})/,
    /[?&]v=([A-Za-z0-9_-]{6,})/,
  ]
  for (const p of patterns) {
    const m = s.match(p)
    if (m?.[1]) return m[1]
  }
  return null
}

function getVimeoId(input?: string | null): string | null {
  if (!input) return null
  const m = String(input).match(/vimeo\.com\/(?:video\/)?(\d+)/)
  return m?.[1] ?? null
}

const url = settings?.showreelUrl ?? DEFAULT_URL
const poster = settings?.showreelPoster ?? DEFAULT_POSTER
const youtubeId = getYouTubeId(url)
const vimeoId = getVimeoId(url)
const provider = vimeoId ? "vimeo" : "youtube"
const embedId = vimeoId ?? youtubeId ?? "cIFqyLFVG4g"
---

<section class="relative bg-ocean">
  <button
    type="button"
    id="showreel-trigger"
    class="group relative block w-full overflow-hidden focus:outline-none"
    aria-haspopup="dialog"
    aria-controls="showreel-dialog"
  >
    <img
      src={poster}
      alt=""
      class="block aspect-[16/9] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      loading="lazy"
      decoding="async"
    />

    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ocean/70 via-ocean/20 to-transparent" />

    <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
      <span class="flex h-20 w-20 items-center justify-center rounded-full border border-paper/70 bg-paper/10 backdrop-blur-sm transition-all duration-300 group-hover:h-24 group-hover:w-24 group-hover:border-paper group-hover:bg-paper/20 sm:h-28 sm:w-28">
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="h-8 w-8 translate-x-[2px] text-paper sm:h-10 sm:w-10"
        >
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 px-6 pb-8 sm:px-10 sm:pb-10">
      <p class="font-display text-3xl uppercase leading-none tracking-wide text-paper sm:text-5xl">
        Watch the reel
      </p>
    </div>
  </button>

  <div
    id="showreel-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Showreel"
    class="pointer-events-none fixed inset-0 z-[120] grid place-items-center bg-black/85 opacity-0 backdrop-blur-md transition-opacity duration-300"
  >
    <button
      type="button"
      id="showreel-close"
      class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-paper/10 text-paper transition hover:bg-paper/20 sm:right-6 sm:top-6"
      aria-label="Close showreel"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path stroke-linecap="round" d="M6 6l12 12M18 6l-12 12" />
      </svg>
    </button>

    <div class="w-full max-w-[1200px] px-4 sm:px-8">
      <div class="overflow-hidden bg-black">
        <div
          id="showreel-player"
          data-plyr-provider={provider}
          data-plyr-embed-id={embedId}
          class="plyr__video-embed"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  ;(() => {
    const trigger = document.getElementById("showreel-trigger")
    const dialog = document.getElementById("showreel-dialog")
    const closeBtn = document.getElementById("showreel-close")
    const target = document.getElementById("showreel-player")
    if (!trigger || !dialog || !closeBtn || !target) return

    let player: any = null

    const setupPlayer = async () => {
      if (player) return player
      const mod = await import("plyr")
      const Plyr = (mod as any).default
      player = new Plyr(target, {
        controls: ["play-large", "play", "progress", "current-time", "mute", "volume", "fullscreen"],
        youtube: { noCookie: true, rel: 0, modestbranding: 1 },
        autoplay: true,
      })
      return player
    }

    const open = async () => {
      dialog.classList.remove("opacity-0", "pointer-events-none")
      dialog.classList.add("opacity-100", "pointer-events-auto")
      document.documentElement.classList.add("overflow-hidden")
      const p = await setupPlayer()
      try {
        await p.play?.()
      } catch {}
    }

    const close = () => {
      dialog.classList.remove("opacity-100", "pointer-events-auto")
      dialog.classList.add("opacity-0", "pointer-events-none")
      document.documentElement.classList.remove("overflow-hidden")
      if (player) {
        try {
          player.pause?.()
        } catch {}
      }
    }

    trigger.addEventListener("click", open)
    closeBtn.addEventListener("click", close)
    dialog.addEventListener("click", e => {
      if (e.target === dialog) close()
    })
    window.addEventListener("keydown", e => {
      if (e.key === "Escape") close()
    })
  })()
</script>
