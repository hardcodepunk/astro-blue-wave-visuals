---
import { sanity } from "../lib/sanity"

type Step = {
  _key?: string
  title: string
  body?: string
}

type Doc = {
  heading?: string
  intro?: string
  steps?: Step[]
} | null

const doc = await sanity.fetch<Doc>(`
  *[_type == "processSteps" && _id == "processSteps"][0]{
    heading,
    intro,
    steps
  }
`)

const heading = doc?.heading ?? "How we work"
const intro = doc?.intro ?? ""
const steps = doc?.steps ?? []
---

{
  steps.length > 0 && (
    <section class="bg-paper py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-4">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="font-display text-5xl uppercase leading-[0.95] tracking-wide text-ocean sm:text-6xl md:text-7xl">
            {heading}
          </h2>
          {intro && <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-ocean/80 sm:text-lg">{intro}</p>}
        </div>

        <ol class="mt-14 grid gap-10 md:mt-20 md:grid-cols-3 md:gap-8">
          {steps.map((step, i) => (
            <li class="relative pl-8 md:pl-0 md:pt-10">
              <span
                aria-hidden="true"
                class="absolute left-0 top-0 font-display text-3xl leading-none text-ocean/40 md:text-4xl"
              >
                {String(i + 1).padStart(2, "0")}
              </span>

              <h3 class="font-display text-2xl uppercase leading-tight text-ocean sm:text-3xl">
                {step.title}
              </h3>
              {step.body && <p class="mt-3 max-w-sm text-base leading-relaxed text-ocean/80">{step.body}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
