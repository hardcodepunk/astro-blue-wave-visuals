---
import Icon from "../Icon.astro";
import Photo from "../Photo.astro";
import { projects } from "~/data/site";

// Everything except the two galleries that navigate to their own page opens
// in the dialog below.
const openable = projects.filter((p) => p.kind !== "gallery-link");
---

<section id="work" class="relative px-6 py-28 md:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="mb-4 text-xs tracking-[0.3em] text-primary uppercase">
          — Selected Work
        </p>
        <h2 class="text-4xl leading-[1.05] text-primary md:text-7xl">
          Film &amp; Stills,<br />one current.
        </h2>
      </div>
      <p class="max-w-md text-foreground/70">
        Tap any tile to open the project — videos play in their native 16:9,
        photo series open in a fullscreen slider.
      </p>
    </div>

    <div
      class="columns-1 gap-6 [column-fill:_balance] sm:columns-2 md:columns-3 md:gap-10 lg:columns-4"
      data-work
    >
      {
        projects.map((project, i) => {
          const inner = (
            <>
              <div
                class:list={["relative w-full overflow-hidden", project.aspect]}
              >
                {project.kind === "video" ? (
                  <video
                    src={project.previewSrc}
                    poster={project.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                ) : (
                  <Photo
                    src={project.cover}
                    alt={project.title}
                    widths={[320, 480, 720]}
                    class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                )}
              </div>

              <div class="mt-4">
                <p class="text-[10px] tracking-[0.28em] text-primary/70 uppercase">
                  {project.category.split("·").pop()?.trim()}
                </p>
                <h3 class="mt-2 font-serif text-xl text-primary md:text-2xl">
                  {project.title}
                </h3>
              </div>
            </>
          );

          const shared = {
            class:
              "group mb-8 block w-full break-inside-avoid text-left md:mb-12",
            "data-reveal": "up",
            style: `--reveal-delay: ${(i % 4) * 0.06}s`,
          };

          return project.kind === "gallery-link" ? (
            <a href={project.href} {...shared}>
              {inner}
            </a>
          ) : (
            <button
              type="button"
              data-open={project.id}
              aria-label={`Open ${project.title}`}
              {...shared}
            >
              {inner}
            </button>
          );
        })
      }
    </div>
  </div>
</section>

<dialog
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-4 backdrop:bg-primary-deep/70 backdrop:backdrop-blur-md md:p-10"
  aria-label="Project viewer"
  data-project-dialog
>
  <div class="flex h-full items-center justify-center">
    <div
      class="relative w-full max-w-5xl overflow-hidden rounded-2xl bg-background shadow-2xl"
    >
      <button
        type="button"
        aria-label="Close"
        class="absolute top-4 right-4 z-20 rounded-full bg-background/80 p-2 text-primary shadow hover:bg-background"
        data-close
      >
        <Icon name="x" class="size-5" />
      </button>

      {
        openable.map((project) => (
          <div
            class="grid md:grid-cols-[1.6fr_1fr]"
            data-panel={project.id}
            hidden
          >
            <div class="relative bg-primary-deep">
              {project.kind === "video" ? (
                <video
                  src={project.videoSrc}
                  poster={project.poster}
                  controls
                  playsinline
                  preload="none"
                  class="h-[40vh] w-full bg-black object-contain md:h-[70vh]"
                />
              ) : (
                <>
                  {project.images.map((src, s) => (
                    <div data-slide={s} hidden={s > 0}>
                      <Photo
                        src={src}
                        alt={`${project.title} ${s + 1}`}
                        layout="dialog"
                        class="h-[40vh] w-full bg-primary-deep object-contain md:h-[70vh]"
                      />
                    </div>
                  ))}

                  <button
                    type="button"
                    aria-label="Previous"
                    class="absolute top-1/2 left-3 -translate-y-1/2 rounded-full bg-background/80 p-2 text-primary shadow hover:bg-background"
                    data-prev
                  >
                    <Icon name="chevron-left" class="size-5" />
                  </button>
                  <button
                    type="button"
                    aria-label="Next"
                    class="absolute top-1/2 right-3 -translate-y-1/2 rounded-full bg-background/80 p-2 text-primary shadow hover:bg-background"
                    data-next
                  >
                    <Icon name="chevron-right" class="size-5" />
                  </button>
                  <p
                    class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-background/80 px-3 py-1 text-[10px] tracking-[0.25em] text-primary uppercase"
                    aria-live="polite"
                    data-counter
                  >
                    1 / {project.images.length}
                  </p>
                </>
              )}
            </div>

            <div class="flex flex-col gap-4 p-6 md:p-8">
              <span class="text-xs tracking-[0.2em] text-muted-foreground uppercase">
                {project.category}
              </span>
              <h3 class="text-3xl text-primary md:text-4xl">{project.title}</h3>
              <p class="text-sm leading-relaxed text-foreground/80">
                {project.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-project-dialog]",
  );
  const grid = document.querySelector("[data-work]");
  if (dialog && grid) {
    const panels = [...dialog.querySelectorAll<HTMLElement>("[data-panel]")];

    const slidesIn = (panel: HTMLElement) => [
      ...panel.querySelectorAll<HTMLElement>("[data-slide]"),
    ];

    const showSlide = (panel: HTMLElement, next: number) => {
      const slides = slidesIn(panel);
      if (!slides.length) return;
      const index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => (slide.hidden = i !== index));
      const counter = panel.querySelector("[data-counter]");
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
    };

    const activeIndex = (panel: HTMLElement) =>
      slidesIn(panel).findIndex((slide) => !slide.hidden);

    const stopMedia = () =>
      dialog.querySelectorAll("video").forEach((video) => video.pause());

    grid.addEventListener("click", (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-open]",
      );
      if (!trigger) return;

      const id = trigger.dataset.open;
      panels.forEach((panel) => {
        const match = panel.dataset.panel === id;
        panel.hidden = !match;
        if (match) showSlide(panel, 0);
      });

      // showModal() brings the focus trap, Escape handling and inert
      // background that the old React overlay had to hand-roll — and didn't.
      dialog.showModal();
    });

    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      if (target.closest("[data-close]") || target === dialog) {
        dialog.close();
        return;
      }

      const panel = target.closest<HTMLElement>("[data-panel]");
      if (!panel) return;

      if (target.closest("[data-next]"))
        showSlide(panel, activeIndex(panel) + 1);
      if (target.closest("[data-prev]"))
        showSlide(panel, activeIndex(panel) - 1);
    });

    dialog.addEventListener("keydown", (event) => {
      const panel = panels.find((p) => !p.hidden);
      if (!panel || !slidesIn(panel).length) return;
      if (event.key === "ArrowRight") showSlide(panel, activeIndex(panel) + 1);
      if (event.key === "ArrowLeft") showSlide(panel, activeIndex(panel) - 1);
    });

    // Fires for Escape too, so this is the single place media gets stopped.
    dialog.addEventListener("close", stopMedia);

    // Tile videos preview on hover; preload="none" means nothing is fetched
    // until the pointer actually lands on one.
    grid.querySelectorAll("video").forEach((video) => {
      const tile = video.closest("a, button");
      tile?.addEventListener(
        "mouseenter",
        () => void video.play().catch(() => {}),
      );
      tile?.addEventListener("mouseleave", () => {
        video.pause();
        video.currentTime = 0;
      });
    });
  }
</script>
