---
import Icon from "../Icon.astro";
import { site } from "~/data/site";

const subject = encodeURIComponent("New project with Bluewave Visuals");
---

<section id="contact" class="relative px-6 py-28 text-center md:py-40">
  <div class="mx-auto max-w-3xl">
    <p class="mb-4 text-xs tracking-[0.3em] text-primary uppercase">
      — Contact
    </p>

    <h2 class="text-5xl leading-[1] text-primary md:text-7xl">
      Let's work<br />together.
    </h2>

    <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-foreground/80">
      Tell us about your project — a film, a campaign, a wave that needs
      chasing. We read every message.
    </p>

    <a
      href={`mailto:${site.email}?subject=${subject}`}
      class="group mt-10 inline-flex items-center gap-3 rounded-full bg-primary px-10 py-5 text-sm tracking-[0.3em] text-primary-foreground uppercase shadow-xl transition hover:scale-[1.02] hover:bg-primary-deep"
    >
      <Icon name="mail" class="size-4" />
      Get in touch
    </a>

    <p class="mt-6 text-sm tracking-[0.2em] text-muted-foreground uppercase">
      {site.email} · {site.location}
    </p>
  </div>
</section>
