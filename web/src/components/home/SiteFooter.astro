---
import { site } from "~/data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-primary/20 px-6 py-10">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-xs tracking-[0.2em] text-primary uppercase md:flex-row"
  >
    <img src="/logo.svg" alt={site.name} class="h-6 w-auto opacity-80" />
    <p>© {year} {site.name} — Made with salt water.</p>
  </div>
</footer>
