---
import { sanity } from "../lib/sanity"

const settings = await sanity.fetch(
  `*[_type == "siteSettings" && _id == "siteSettings"][0]{
    title,
    instagramUrl
  }`,
)
---

<section class="relative mx-auto max-w-6xl px-4 py-20">
  <div class="overflow-hidden rounded-2xl bg-ocean px-6 py-16 text-center text-ocean">
    <h2 class="font-display text-paper text-3xl">Let’s film something real</h2>

    <p class="mt-2 text-paper">
      Lifestyle, outdoor, and brand content — shot with purpose. Based in Belgium, available worldwide.
    </p>

    <div class="mt-6 flex items-center justify-center gap-4">
      <a href="/contact" class="rounded-md bg-paper px-5 py-2 text-ocean"> Send a message </a>

      <a
        href={settings.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border text-paper border-paper px-5 py-2"
      >
        Instagram
      </a>
    </div>
  </div>
</section>
