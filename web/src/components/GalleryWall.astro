---
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { getImage } from "~/lib/images";

interface Props {
  images: string[];
  label: string;
}

const { images, label } = Astro.props;
// Full-resolution sources for the viewer; the tiles below render their own
// responsive variants through <Photo>.
const fullSizes = images.map((path) => getImage(path).src);
---

<section class="px-3 pb-20 md:px-6">
  <div
    class="columns-1 gap-3 sm:columns-2 md:columns-3 md:gap-4 lg:columns-4"
    data-gallery
  >
    {
      images.map((path, i) => (
        <button
          type="button"
          class="group mb-3 block w-full break-inside-avoid overflow-hidden md:mb-4"
          data-index={i}
          aria-label={`Open ${label} ${i + 1} of ${images.length}`}
          data-reveal="up"
          style={`--reveal-delay: ${(i % 4) * 0.05}s`}
        >
          <Photo
            src={path}
            alt={`${label} ${i + 1}`}
            loading={i < 4 ? "eager" : "lazy"}
            class="h-auto w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          />
        </button>
      ))
    }
  </div>
</section>

<dialog
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-4 backdrop:bg-black/85 backdrop:backdrop-blur-md md:p-10"
  aria-label={`${label} viewer`}
  data-lightbox
>
  <div class="relative flex h-full items-center justify-center">
    <button
      type="button"
      aria-label="Close"
      class="absolute top-0 right-0 z-20 rounded-full bg-background/80 p-2 text-primary shadow hover:bg-background"
      data-close
    >
      <Icon name="x" class="size-5" />
    </button>

    <button
      type="button"
      aria-label="Previous"
      class="absolute top-1/2 left-0 z-20 -translate-y-1/2 rounded-full bg-background/80 p-2 text-primary shadow hover:bg-background md:left-2"
      data-prev
    >
      <Icon name="chevron-left" class="size-5" />
    </button>

    <button
      type="button"
      aria-label="Next"
      class="absolute top-1/2 right-0 z-20 -translate-y-1/2 rounded-full bg-background/80 p-2 text-primary shadow hover:bg-background md:right-2"
      data-next
    >
      <Icon name="chevron-right" class="size-5" />
    </button>

    <img
      alt=""
      class="max-h-[88vh] max-w-[92vw] object-contain shadow-2xl"
      data-frame
    />

    <p
      class="absolute bottom-0 left-1/2 -translate-x-1/2 rounded-full bg-background/80 px-3 py-1 text-[10px] tracking-[0.25em] text-primary uppercase"
      aria-live="polite"
      data-counter
    >
    </p>
  </div>
</dialog>

<script is:inline define:vars={{ sources: fullSizes, label }}>
  (() => {
    const dialog = document.querySelector("[data-lightbox]");
    const wall = document.querySelector("[data-gallery]");
    if (!(dialog instanceof HTMLDialogElement) || !wall) return;

    const frame = dialog.querySelector("[data-frame]");
    const counter = dialog.querySelector("[data-counter]");
    let index = 0;

    const render = () => {
      frame.src = sources[index];
      frame.alt = `${label} ${index + 1}`;
      counter.textContent = `${index + 1} / ${sources.length}`;
    };

    const go = (step) => {
      index = (index + step + sources.length) % sources.length;
      render();
    };

    wall.addEventListener("click", (event) => {
      const tile = event.target.closest("[data-index]");
      if (!tile) return;
      index = Number(tile.dataset.index);
      render();
      // showModal() gives us the focus trap, Escape handling and an inert
      // background for free — the reason this is a <dialog> and not a div.
      dialog.showModal();
    });

    dialog
      .querySelector("[data-close]")
      .addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-prev]").addEventListener("click", () => go(-1));
    dialog.querySelector("[data-next]").addEventListener("click", () => go(1));

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") go(1);
      if (event.key === "ArrowLeft") go(-1);
    });

    // Clicking the backdrop (outside the image) dismisses.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
