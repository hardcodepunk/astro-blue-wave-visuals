---
const { title = "Bluewave Visuals", description = "Cinematic storytelling through sea, light, and motion." } =
  Astro.props
import "../styles/globals.css"
import StickyHeader from "../components/StickyHeader.astro"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Andada+Pro:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
  </head>

  <body class="font-sans min-h-screen flex flex-col bg-paper text-ocean">
    <StickyHeader />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 py-10 bg-ocean text-paper">
      <div class="max-w-6xl mx-auto px-4 flex items-center justify-between text-sm">
        <p>© {new Date().getFullYear()} Bluewave Visuals</p>
        <div class="space-x-4">
          <a href="https://www.instagram.com/bluewave.visuals/" target="_blank">Instagram</a>
          <a href="mailto:info@bluewavevisuals.com">Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
