---
import Base from "../layouts/Base.astro"
import VideoHero from "../components/VideoHero.tsx"
import ServicesSection from "../components/ServicesSection.astro"
import FeaturedGrid from "../components/FeaturedGrid.astro"
import AboutTeaser from "../components/AboutTeaser.astro"
import ShopPreview from "../components/ShopPreview.astro"
import ContactCTA from "../components/ContactCTA.astro"
import { sanity } from "../lib/sanity"

const settings = await sanity.fetch(`*[_type == "siteSettings" && _id == "siteSettings"][0]{
  title,
  description,
  heroTitle,
  heroSubtitle,
  heroMp4,
  heroWebm,
  heroPoster
}`)
---

<Base title={settings.title} description={settings.description}>
  <VideoHero
    webm={settings.heroWebm}
    mp4={settings.heroMp4}
    poster={settings.heroPoster}
    title={settings.heroTitle}
    subtitle={settings.heroSubtitle}
    client:load
  />

  <ServicesSection />
  <FeaturedGrid />
  <AboutTeaser />
  <ShopPreview />
  <ContactCTA />
</Base>
