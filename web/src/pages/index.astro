---
import Base from "../layouts/Base.astro"
import VideoHero from "../components/VideoHero.tsx"
import BioWithPreview from "../components/BioWithPreview.astro"
import ServicesSection from "../components/ServicesSection.astro"
import TrustedBy from "../components/TrustedBy.astro"
import ProcessSection from "../components/ProcessSection.astro"
import ContactSection from "../components/ContactSection.astro"
import { sanity } from "../lib/sanity"

type SiteSettings = {
  title?: string
  description?: string
  heroTitle?: string
  heroSubtitle?: string
  heroMp4?: string
  heroWebm?: string
  heroPoster?: string
  showreelUrl?: string
} | null

const settings = await sanity.fetch<SiteSettings>(`
  *[_type == "siteSettings" && _id == "siteSettings"][0]{
    title,
    description,
    heroTitle,
    heroSubtitle,
    heroMp4,
    heroWebm,
    heroPoster,
    showreelUrl
  }
`)

const siteTitle = settings?.title ?? "Blue Wave Visuals"
const siteDescription = settings?.description ?? "Creative visual storytelling for brands, events, and businesses."

const heroTitle = settings?.heroTitle ?? "Blue Wave Visuals"
const heroSubtitle = settings?.heroSubtitle ?? ""
const heroMp4 = settings?.heroMp4 ?? undefined
const heroWebm = settings?.heroWebm ?? undefined
const heroPoster = settings?.heroPoster ?? undefined
const showreelUrl = settings?.showreelUrl ?? undefined
---

<Base title={siteTitle} description={siteDescription}>
  <VideoHero
    webm={heroWebm}
    mp4={heroMp4}
    poster={heroPoster}
    title={heroTitle}
    subtitle={heroSubtitle}
    showreelUrl={showreelUrl}
    client:load
  />

  <BioWithPreview />

  <ServicesSection />

  <ProcessSection />

  <TrustedBy />

  <ContactSection />
</Base>
