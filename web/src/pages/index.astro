---
import Base from "../layouts/Base.astro"
import VideoHero from "../components/VideoHero.tsx"
import ServicesSection from "../components/ServicesSection.astro"
import FeaturedGrid from "../components/FeaturedGrid.astro"
import AboutTeaser from "../components/AboutTeaser.astro"
import ShopPreview from "../components/ShopPreview.astro"
import ContactCTA from "../components/ContactCTA.astro"
import { sanity } from "../lib/sanity"

type SiteSettings = {
  title?: string
  description?: string
  heroTitle?: string
  heroSubtitle?: string
  heroMp4?: string
  heroWebm?: string
  heroPoster?: string
} | null

const settings = await sanity.fetch<SiteSettings>(`
  *[_type == "siteSettings" && _id == "siteSettings"][0]{
    title,
    description,
    heroTitle,
    heroSubtitle,
    "heroMp4": heroMp4.asset->url,
    "heroWebm": heroWebm.asset->url,
    "heroPoster": heroPoster.asset->url
  }
`)

const siteTitle = settings?.title ?? "Blue Wave Visuals"
const siteDescription = settings?.description ?? "Creative visual storytelling for brands, events, and businesses."

const heroTitle = settings?.heroTitle ?? "Blue Wave Visuals"
const heroSubtitle = settings?.heroSubtitle ?? ""
const heroMp4 = settings?.heroMp4 ?? undefined
const heroWebm = settings?.heroWebm ?? undefined
const heroPoster = settings?.heroPoster ?? undefined
---

<Base title={siteTitle} description={siteDescription}>
  <VideoHero webm={heroWebm} mp4={heroMp4} poster={heroPoster} title={heroTitle} subtitle={heroSubtitle} client:load />

  <ServicesSection />
  <AboutTeaser />
  <ContactCTA />
</Base>
