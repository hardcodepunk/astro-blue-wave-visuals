---
import Nav from "~/components/Nav.astro";
import WaveDivider from "~/components/WaveDivider.astro";
import About from "~/components/home/About.astro";
import Contact from "~/components/home/Contact.astro";
import Hero from "~/components/home/Hero.astro";
import Philosophy from "~/components/home/Philosophy.astro";
import QuoteBand from "~/components/home/QuoteBand.astro";
import Services from "~/components/home/Services.astro";
import SiteFooter from "~/components/home/SiteFooter.astro";
import TrustedBy from "~/components/home/TrustedBy.astro";
import WorkGrid from "~/components/home/WorkGrid.astro";
import Base from "~/layouts/Base.astro";
---

<Base>
  <main class="relative overflow-x-hidden bg-background text-foreground">
    <Nav variant="home" />

    <Hero />
    <WaveDivider />

    <Philosophy />
    <WaveDivider />

    <About />
    <WaveDivider />

    <Services />
    <WaveDivider />

    <WorkGrid />

    <TrustedBy />
    <WaveDivider />

    <QuoteBand />
    <WaveDivider />

    <Contact />

    <SiteFooter />
  </main>
</Base>
